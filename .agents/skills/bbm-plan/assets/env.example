# bbm-plan keys — copy this file to `.env` next to `bbm_providers.json` and
# fill in the one variable your provider entry names in `env_key`. The skill
# sources it before every run. Never commit a filled .env.
#
# The route itself (endpoint, format, model) lives in `bbm_providers.json`,
# not here. `--provider NAME` reads the entry; this file only supplies the
# key the entry points at.

# The example provider file's entries name these:
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GATEWAY_API_KEY=

# Read for any format when the entry names no env_key.
#BBM_API_KEY=

# `--model orcarouter` needs no entry; it reads this.
#BBM_ORCAROUTER_API_KEY=

# The codex route (`--api_format codex`) uses no key at all — `codex login`.

# Only if you have a Datalab key: lets a PDF be read by the hosted Datalab
# Convert API (`--pdf-parser datalab`) instead of the local models.
#DATALAB_API_KEY=
