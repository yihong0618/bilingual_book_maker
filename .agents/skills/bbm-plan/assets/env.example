# bbm-plan credentials — copy this file to `.env` and fill it in. The skill
# sources it before every run. Never commit a filled .env.

# The one field that must be set: the exact model name to translate with.
MODEL=

# One API key — whichever provider the model lives at.
OPENAI_API_KEY=
#BBM_CLAUDE_API_KEY=
#BBM_GOOGLE_GEMINI_KEY=
#BBM_GROQ_API_KEY=
#BBM_XAI_API_KEY=
#BBM_QWEN_API_KEY=
#BBM_DEEPL_API_KEY=
#BBM_CAIYUN_API_KEY=
#BBM_CUSTOM_API=

# Custom endpoint base URL (OpenAI-compatible proxies, self-hosted, …).
# Leave unset for the provider default; the skill probes the format and
# fixes the path itself.
#BBM_API_BASE=
