# for user do not want to push
*.srt
*.txt
# the exported dependency pins are tracked; the rule above is for run output
# This is an ALLOWLIST under `*.txt` above: a requirements file that is not
# named here is silently never committed, however it was added (seen 260921 --
# the two PDF files below were written, committed past, and absent from the
# repo while CI and the Dockerfile referenced them).
!requirements.txt
!requirements-pdf-cpu.txt
!requirements-pdf-gpu.txt
*.bin
*.epub

# For markdown files in user directories
.cursorrules
books/
prompts/
.pdm-python

# per-book translation plan artifacts (generated by --plan-dry-run / plan mode)
*_plan.json

# epubcheck is fetched on demand by whoever runs the corpus gate; the
# unpacked distribution itself is not source. No trailing slash: it is as
# often a symlink to one shared copy as a real directory, and the slash form
# matches only the directory — which is how it once reached `git add -A`.
tools/epubcheck-*

# the acceptance corpus, fetched or symlinked next to the checkout, never
# committed: it is other people's books
epub-sample

# where runs put what they produce: the corpus gate writes its partition
# audit here, and translated books land next to it
output/

# your own provider entries, copied from bbm_providers.example.json
bbm_providers.json
